<Window x:Class="DerechHadasha.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DerechHadasha.Converters"
        xmlns:views="clr-namespace:DerechHadasha.Views"
        Title="דרך חדשה - ניהול עבודה והכנסות" Height="860" Width="1280" MinHeight="720" MinWidth="1050"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <conv:ShiftTypeConverter x:Key="ShiftTypeConverter" />
        <conv:NumberToHeightConverter x:Key="NumberToHeightConverter" />
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Effect">
                <Setter.Value><DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.10" /></Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,0,10" />
            <Setter Property="Padding" Value="9" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="{DynamicResource CardBrush}" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <views:LogoMark Width="72" Height="72" />
                <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                    <TextBlock Text="דרך חדשה - ניהול עבודה והכנסות" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="מערכת אישית לניהול משמרות, הכנסות, דוחות וגיבויים" FontSize="14" Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="רענון" Command="{Binding RefreshCommand}" />
                    <Button Content="מצב כהה/בהיר" Command="{Binding ToggleThemeCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource CardBrush}">
            <TextBlock Text="{Binding StatusMessage}" />
            <Separator />
            <TextBlock Text="נוצר על ידי חמודה חאלד" Foreground="{DynamicResource MutedTextBrush}" />
        </StatusBar>

        <TabControl Margin="14" Background="Transparent" BorderThickness="0">
            <TabItem Header="לוח בקרה">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <UniformGrid Columns="5" Margin="0,8">
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="הכנסה היום" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock Text="{Binding TodayIncomeText}" FontSize="26" FontWeight="Bold"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="השבוע" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock Text="{Binding WeekIncomeText}" FontSize="26" FontWeight="Bold"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="החודש" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock Text="{Binding MonthIncomeText}" FontSize="26" FontWeight="Bold"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="השנה" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock Text="{Binding YearIncomeText}" FontSize="26" FontWeight="Bold"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="משמרות" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock Text="{Binding Summary.ShiftCount}" FontSize="26" FontWeight="Bold"/></StackPanel></Border>
                        </UniformGrid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Grid.Column="0">
                                <StackPanel>
                                    <TextBlock Text="רשומות עבודה אחרונות" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />
                                    <DataGrid ItemsSource="{Binding RecentEntries}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="260">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="תאריך" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="110"/>
                                            <DataGridTextColumn Header="עובד" Binding="{Binding WorkerName}" Width="120"/>
                                            <DataGridTextColumn Header="משמרת" Binding="{Binding ShiftTypeHebrew}" Width="90"/>
                                            <DataGridTextColumn Header="הכנסה" Binding="{Binding IncomeAmount, StringFormat=C}" Width="110"/>
                                            <DataGridTextColumn Header="שעות" Binding="{Binding HoursWorked}" Width="80"/>
                                            <DataGridTextColumn Header="מה עשינו היום" Binding="{Binding Description}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Grid.Column="1">
                                <StackPanel>
                                    <TextBlock Text="מדדים מהירים" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />
                                    <TextBlock Text="ממוצע הכנסה למשמרת" Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding AverageShiftText}" FontSize="24" FontWeight="Bold" Margin="0,0,0,18" />
                                    <TextBlock Text="ממוצע הכנסה ליום עבודה" Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding AverageDayText}" FontSize="24" FontWeight="Bold" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="רשומת עבודה">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <ScrollViewer>
                            <StackPanel>
                                <TextBlock Text="טופס עבודה" FontSize="22" FontWeight="Bold" Margin="0,0,0,16" />
                                <TextBlock Text="שם העובד"/><TextBox Text="{Binding CurrentEntry.WorkerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="תאריך"/>
                                <DockPanel Margin="0,4,0,10">
                                    <Button DockPanel.Dock="Left" Content="היום" Command="{Binding SetTodayCommand}" Padding="10,6" />
                                    <DatePicker SelectedDate="{Binding CurrentEntry.Date, Mode=TwoWay}" />
                                </DockPanel>
                                <TextBlock Text="סוג משמרת"/>
                                <ComboBox ItemsSource="{Binding ShiftTypes}" SelectedItem="{Binding CurrentEntry.ShiftType, Converter={StaticResource ShiftTypeConverter}, Mode=TwoWay}" Margin="0,4,0,6" Padding="8" />
                                <WrapPanel Margin="0,0,0,10">
                                    <Button Content="בוקר" Command="{Binding SetMorningShiftCommand}" Padding="10,6" />
                                    <Button Content="לילה" Command="{Binding SetNightShiftCommand}" Padding="10,6" />
                                    <Button Content="בוקר ולילה" Command="{Binding SetBothShiftsCommand}" Padding="10,6" />
                                </WrapPanel>
                                <TextBlock Text="סכום הכנסה"/><TextBox Text="{Binding CurrentEntry.IncomeAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="שעות עבודה"/><TextBox Text="{Binding CurrentEntry.HoursWorked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="מה עשינו היום"/><TextBox Text="{Binding CurrentEntry.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="86" TextWrapping="Wrap" />
                                <TextBlock Text="הערות"/><TextBox Text="{Binding CurrentEntry.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="86" TextWrapping="Wrap" />
                                <TextBlock Text="תמונה מצורפת"/><TextBox Text="{Binding CurrentEntry.ImagePath}" IsReadOnly="True" />
                                <WrapPanel>
                                    <Button Content="צרף תמונה" Command="{Binding AttachImageCommand}" />
                                    <Button Content="נקה טופס" Command="{Binding ClearFormCommand}" />
                                    <Button Content="שמור" Command="{Binding SaveEntryCommand}" Background="{DynamicResource AccentBrush}" />
                                    <Button Content="ערוך נבחר" Command="{Binding EditSelectedCommand}" />
                                    <Button Content="מחק נבחר" Command="{Binding DeleteSelectedCommand}" Background="{DynamicResource DangerBrush}" />
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <Border Style="{StaticResource Card}" Grid.Column="1">
                        <DataGrid ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="תאריך" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="110"/>
                                <DataGridTextColumn Header="עובד" Binding="{Binding WorkerName}" Width="120"/>
                                <DataGridTextColumn Header="משמרת" Binding="{Binding ShiftTypeHebrew}" Width="90"/>
                                <DataGridTextColumn Header="הכנסה" Binding="{Binding IncomeAmount, StringFormat=C}" Width="110"/>
                                <DataGridTextColumn Header="שעות" Binding="{Binding HoursWorked}" Width="80"/>
                                <DataGridTextColumn Header="מה עשינו היום" Binding="{Binding Description}" Width="2*"/>
                                <DataGridTextColumn Header="הערות" Binding="{Binding Notes}" Width="2*"/>
                                <DataGridTextColumn Header="תמונה" Binding="{Binding ImagePath}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="דוחות וחיפוש">
                <DockPanel Margin="8">
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="מתאריך" VerticalAlignment="Center" Margin="8"/><DatePicker SelectedDate="{Binding ReportFromDate}" Margin="4" />
                            <TextBlock Text="עד תאריך" VerticalAlignment="Center" Margin="8"/><DatePicker SelectedDate="{Binding ReportToDate}" Margin="4" />
                            <Button Content="יומי" Command="{Binding SetDailyReportCommand}" />
                            <Button Content="שבועי" Command="{Binding SetWeeklyReportCommand}" />
                            <Button Content="חודשי" Command="{Binding SetMonthlyReportCommand}" />
                            <Button Content="טווח מותאם" Command="{Binding SearchReportRangeCommand}" />
                            <Button Content="ייצוא PDF" Command="{Binding ExportPdfCommand}" Background="{DynamicResource AccentBrush}" />
                            <Button Content="הדפסה" Command="{Binding PrintReportCommand}" />
                        </WrapPanel>
                    </Border>
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="חיפוש" VerticalAlignment="Center" Margin="8"/><TextBox Text="{Binding SearchKeyword}" Width="180" />
                            <TextBlock Text="מתאריך" VerticalAlignment="Center" Margin="8"/><DatePicker SelectedDate="{Binding SearchFromDate}" Margin="4" />
                            <TextBlock Text="עד" VerticalAlignment="Center" Margin="8"/><DatePicker SelectedDate="{Binding SearchToDate}" Margin="4" />
                            <TextBlock Text="משמרת" VerticalAlignment="Center" Margin="8"/><ComboBox ItemsSource="{Binding SearchShiftTypes}" SelectedItem="{Binding SelectedSearchShift}" Width="125" Padding="8" />
                            <Button Content="חפש" Command="{Binding SearchCommand}" />
                        </WrapPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <DataGrid ItemsSource="{Binding Entries}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="תאריך" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="110"/>
                                <DataGridTextColumn Header="עובד" Binding="{Binding WorkerName}" Width="120"/>
                                <DataGridTextColumn Header="משמרת" Binding="{Binding ShiftTypeHebrew}" Width="90"/>
                                <DataGridTextColumn Header="הכנסה" Binding="{Binding IncomeAmount, StringFormat=C}" Width="110"/>
                                <DataGridTextColumn Header="שעות" Binding="{Binding HoursWorked}" Width="80"/>
                                <DataGridTextColumn Header="מה עשינו היום" Binding="{Binding Description}" Width="2*"/>
                                <DataGridTextColumn Header="הערות" Binding="{Binding Notes}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>
            </TabItem>

            <TabItem Header="סטטיסטיקות וגיבוי">
                <ScrollViewer>
                    <StackPanel Margin="8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Grid.Column="0">
                                <StackPanel>
                                    <TextBlock Text="גרף הכנסות חודשי" FontSize="20" FontWeight="Bold" />
                                    <ItemsControl ItemsSource="{Binding MonthlyChart}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="4" VerticalAlignment="Bottom">
                                                    <Border Width="28" Height="{Binding Value, Converter={StaticResource NumberToHeightConverter}, ConverterParameter=180}" Background="{DynamicResource PrimaryBrush}" CornerRadius="6" VerticalAlignment="Bottom" />
                                                    <TextBlock Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Grid.Column="1">
                                <StackPanel>
                                    <TextBlock Text="גרף הכנסות שנתי" FontSize="20" FontWeight="Bold" />
                                    <ItemsControl ItemsSource="{Binding YearlyChart}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="8" VerticalAlignment="Bottom">
                                                    <Border Width="42" Height="{Binding Value, Converter={StaticResource NumberToHeightConverter}, ConverterParameter=180}" Background="{DynamicResource AccentBrush}" CornerRadius="8" />
                                                    <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource Card}">
                            <WrapPanel>
                                <Button Content="ייצוא גיבוי למסד הנתונים" Command="{Binding ExportBackupCommand}" />
                                <Button Content="שחזור גיבוי" Command="{Binding RestoreBackupCommand}" Background="{DynamicResource DangerBrush}" />
                                <TextBlock Text="הנתונים נשמרים מקומית ב-SQLite עבור משתמש יחיד בלבד." VerticalAlignment="Center" Margin="16,0" Foreground="{DynamicResource MutedTextBrush}" />
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
