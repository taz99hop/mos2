<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BackgroundColor">#F5F7FB</Color>
    <Color x:Key="CardColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">#16213E</Color>
    <Color x:Key="MutedTextColor">#687083</Color>
    <Color x:Key="PrimaryColor">#0EA5E9</Color>
    <Color x:Key="AccentColor">#22C55E</Color>
    <Color x:Key="DangerColor">#EF4444</Color>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
</ResourceDictionary>
